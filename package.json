{
  "name": "dinnerquest",
  "type": "module",
  "version": "2.0.0",
  "description": "A text-based RPG roguelike for couples to decide on dinner for the week",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "rm -rf dist && vite build --mode client && vite build",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:seed": "tsx scripts/seed/seed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mjoslyn/dinnerquest.git"
  },
  "keywords": [
    "game",
    "rpg",
    "dinner",
    "couples"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "hono": "4.12.32",
    "honox": "0.1.59"
  },
  "devDependencies": {
    "@hono/vite-build": "1.11.1",
    "@hono/vite-dev-server": "0.26.1",
    "@playwright/test": "^1.57.0",
    "gray-matter": "4.0.3",
    "tsx": "4.23.1",
    "vite": "7.3.6",
    "vitest": "3.2.4",
    "wrangler": "4.114.0",
    "zod": "4.4.3"
  }
}
